# ---------- Banco ----------
# Postgres (Neon/Supabase em produção; local em desenvolvimento)
DATABASE_URL=postgres://portal:portal@localhost:5432/portal

# ---------- Coletores ----------
# E-mail de contato enviado no User-Agent das requisições às fontes oficiais (boa prática de coleta)
COLETOR_EMAIL_CONTATO=
# URL pública do site (também vai no User-Agent)
SITE_URL=http://localhost:3000
# Pasta onde as respostas brutas são guardadas (gzip). Em produção, apontar para storage persistente.
DADOS_BRUTOS_DIR=./dados-brutos

# ---------- Fases futuras (deixar vazio por enquanto) ----------
# DOU – INLABS (Fase 2): cadastro gratuito em inlabs.in.gov.br
INLABS_EMAIL=
INLABS_SENHA=
# DataJud / CNJ (Fase 3): chave pública publicada em https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# Portal da Transparência / CGU (fase posterior): cadastro gratuito
PORTAL_TRANSPARENCIA_CHAVE=
# e-Agendas / CGU (agenda do Vice e de ministros): token pessoal gerado em eagendas.cgu.gov.br (login gov.br)
EAGENDAS_TOKEN=
# Alertas (Fase 4)
WEB_PUSH_VAPID_PUBLIC=
WEB_PUSH_VAPID_PRIVATE=
SMTP_URL=
TELEGRAM_BOT_TOKEN=
